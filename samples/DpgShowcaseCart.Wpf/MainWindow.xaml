<Window x:Class="DpgShowcaseCart.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DpgShowcaseCart.Wpf.Controls"
        xmlns:viewModels="clr-namespace:DpgShowcaseCart.Wpf.ViewModels"
        Title="Fintech Mock Checkout - Powered by Kassyi.Generators.DependencyProperty" Height="750" Width="920" Background="{DynamicResource AppBackgroundBrush}">
    
    <Window.DataContext>
        <viewModels:CheckoutViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side: Real-time display of custom card generated by DPG & Input Form -->
        <Grid Grid.Column="0" Margin="40,24,40,24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
                <TextBlock Text="Kassyi.Generators.DependencyProperty Showcase" Foreground="{DynamicResource AccentLightBrush}" FontSize="12" Margin="0,0,0,16" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                
                <controls:PaymentCardView x:Name="LiveCard"
                                          CardNumber="{Binding CardNumber}"
                                          CardHolder="{Binding CardHolder}"
                                          ExpiryDate="{Binding ExpiryDate}"
                                          Amount="{Binding Amount}"
                                          Status="{Binding Status}"/>
                
                <TextBlock Text="{Binding Amount, StringFormat='Total Due: ${0:F2}'}" 
                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" Margin="0,24,0,24" HorizontalAlignment="Center"/>

                <TextBlock Text="QUICK DEMO PRESETS" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,6"/>
                <UniformGrid Columns="3" Margin="0,0,0,16">
                    <Button Content="Visa (Valid)" Command="{Binding SelectVisaPresetCommand}" Margin="0,0,4,0" Padding="0,8"
                            Background="{DynamicResource PresetVisaBgBrush}" Foreground="{DynamicResource PresetVisaFgBrush}" BorderBrush="{DynamicResource PresetVisaBorderBrush}" BorderThickness="1" 
                            FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                    <Button Content="Master (Valid)" Command="{Binding SelectMasterPresetCommand}" Margin="2,0,2,0" Padding="0,8"
                            Background="{DynamicResource PresetMasterBgBrush}" Foreground="{DynamicResource PresetMasterFgBrush}" BorderBrush="{DynamicResource PresetMasterBorderBrush}" BorderThickness="1" 
                            FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                    <Button Content="Invalid Luhn" Command="{Binding SelectInvalidPresetCommand}" Margin="4,0,0,0" Padding="0,8"
                            Background="{DynamicResource PresetInvalidBgBrush}" Foreground="{DynamicResource PresetInvalidFgBrush}" BorderBrush="{DynamicResource PresetInvalidBorderBrush}" BorderThickness="1" 
                            FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                </UniformGrid>

                <TextBlock Text="Card Number (Luhn Checksum Validation)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="CardInput" 
                         Text="{Binding CardNumber, UpdateSourceTrigger=PropertyChanged}" 
                         Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="10" Margin="0,0,0,4"
                         InputMethod.IsInputMethodEnabled="False" MaxLength="19" controls:TextBoxInputFilter.IsNumericOnly="True" controls:TextBoxInputFilter.SelectAllOnFocus="True">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsValidCardNumber}" Value="False">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                
                <TextBlock FontSize="10" FontWeight="SemiBold" Margin="0,0,0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Text" Value="✖ Invalid checksum (Luhn check failed)"/>
                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsValidCardNumber}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Card Holder" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameInput" 
                                 Text="{Binding CardHolder, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="10"
                                 InputMethod.IsInputMethodEnabled="False" MaxLength="30" controls:TextBoxInputFilter.SelectAllOnFocus="True" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Expires" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="ExpInput" 
                                 Text="{Binding ExpiryDate, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="10"
                                 InputMethod.IsInputMethodEnabled="False" MaxLength="5" controls:TextBoxInputFilter.IsExpiryFormat="True" controls:TextBoxInputFilter.SelectAllOnFocus="True" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"/>
                    </StackPanel>
                </Grid>

                <Button x:Name="PayButton" 
                        Command="{Binding PayCommand}" 
                        Height="46" 
                        Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Content" Value="{Binding Amount}"/>
                            <Setter Property="ContentStringFormat" Value="Pay ${0:F2}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                    <Setter Property="Cursor" Value="No"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding Status}" Value="Processing">
                                    <Setter Property="Content" Value="Processing..."/>
                                    <Setter Property="ContentStringFormat" Value="{x:Null}"/>
                                    <Setter Property="Background" Value="#4C566A"/> <!-- Muted state -->
                                    <Setter Property="Foreground" Value="#E5E9F0"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Approved">
                                    <Setter Property="Content" Value="Payment Successful ✔"/>
                                    <Setter Property="ContentStringFormat" Value="{x:Null}"/>
                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                    <Setter Property="Foreground" Value="#0F172A"/> <!-- Dark text for visibility on light green -->
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter Property="Content" Value="Payment Failed ✖"/>
                                    <Setter Property="ContentStringFormat" Value="{x:Null}"/>
                                    <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- Success Overlay (Apple/Google Pay Style) -->
            <Border Background="{DynamicResource AppBackgroundBrush}" 
                    CornerRadius="12" Margin="-20" Padding="20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Approved">
                                <Setter Property="Visibility" Value="Visible"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="80" Height="80" Margin="0,0,0,24">
                        <Ellipse Fill="{DynamicResource SuccessBrush}" Opacity="0.2"/>
                        <Ellipse Fill="{DynamicResource SuccessBrush}" Width="60" Height="60"/>
                        <Path Data="M 24 40 L 36 52 L 56 32" Stroke="#0F172A" StrokeThickness="6" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>
                    <TextBlock Text="Payment Successful" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Your order has been placed." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,32"/>
                    
                    <!-- Simulated Receipt -->
                    <Border Background="{DynamicResource InspectorBackgroundBrush}" CornerRadius="8" Padding="24" Margin="0,0,0,32" Width="280">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Amount Paid" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Amount, StringFormat='${0:F2}'}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Card Used" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Brand}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <Button Content="Done" Command="{Binding ResetPaymentCommand}" 
                            Height="46" Width="280"
                            Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Right Side: DPG Feature Inspector -->
        <Border Grid.Column="1" Background="{DynamicResource InspectorBackgroundBrush}" BorderBrush="{DynamicResource InspectorBorderBrush}" BorderThickness="1,0,0,0">
            <StackPanel Margin="28,32,28,32">
                <TextBlock Text="⚙ DPG FEATURE INSPECTOR" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,28"/>

                <!-- CardNumber Property -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="● CardNumber Property" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <WrapPanel Margin="16,0,0,6">
                        <Border Background="{DynamicResource BadgeBlueBgBrush}" BorderBrush="{DynamicResource BadgeBlueBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,6">
                            <TextBlock Text="Mode: TwoWay" Foreground="{DynamicResource BadgeBlueFgBrush}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="{DynamicResource BadgePurpleBgBrush}" BorderBrush="{DynamicResource BadgePurpleBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,0,6">
                            <TextBlock Text="AffectsRender: True" Foreground="{DynamicResource BadgePurpleFgBrush}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="Auto-generates boilerplate and connects the real-time card UI with the validation engine." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="16,0,0,0" TextWrapping="Wrap" LineHeight="16"/>
                </StackPanel>

                <!-- Amount Property -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="● Amount Property" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <WrapPanel Margin="16,0,0,6">
                        <Border Background="{DynamicResource BadgeGreenBgBrush}" BorderBrush="{DynamicResource BadgeGreenBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,6">
                            <TextBlock Text="Validate" Foreground="{DynamicResource BadgeGreenFgBrush}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="{DynamicResource BadgeGreenBgBrush}" BorderBrush="{DynamicResource BadgeGreenBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,0,6">
                            <TextBlock Text="Coerce: Anti-negative" Foreground="{DynamicResource BadgeGreenFgBrush}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="Ensures payment amount never drops below zero via CoerceValueCallback generation." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="16,0,0,0" TextWrapping="Wrap" LineHeight="16"/>
                </StackPanel>
                
                <!-- Status Property -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="● Status Property" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <WrapPanel Margin="16,0,0,6">
                        <Border Background="{DynamicResource BadgePurpleBgBrush}" BorderBrush="{DynamicResource BadgePurpleBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,6">
                            <TextBlock Text="CreateDefaultValueCallback" Foreground="{DynamicResource BadgePurpleFgBrush}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="Safely handles reference types without nullability warnings (Fixed in PR #29)." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="16,0,0,0" TextWrapping="Wrap" LineHeight="16"/>
                </StackPanel>
                
                <!-- RoutedEvents -->
                <StackPanel Margin="0,0,0,32">
                    <TextBlock Text="● PaymentProcessed Event" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <WrapPanel Margin="16,0,0,6">
                        <Border Background="{DynamicResource BadgeBlueBgBrush}" BorderBrush="{DynamicResource BadgeBlueBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,6">
                            <TextBlock Text="[RoutedEvent]" Foreground="{DynamicResource BadgeBlueFgBrush}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="{DynamicResource BadgeBlueBgBrush}" BorderBrush="{DynamicResource BadgeBlueBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,0,6">
                            <TextBlock Text="Strategy: Bubble" Foreground="{DynamicResource BadgeBlueFgBrush}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="Zero-allocation event generation using Source Generation." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="16,0,0,0" TextWrapping="Wrap" LineHeight="16"/>
                </StackPanel>
                
                <!-- Footer / Link -->
                <Border Background="#1E1E2E" CornerRadius="6" Padding="16" BorderBrush="#2A2A38" BorderThickness="1" VerticalAlignment="Bottom">
                    <StackPanel>
                        <TextBlock Text="Explore more DPG features:" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="WeakEvents, AttachedProperties, and support for WPF / UWP / WinUI / Uno / Avalonia / MAUI." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="16"/>
                        <Button Content="Open GitHub Wiki ↗" Click="OnWikiButtonClicked"
                                Background="#388BFD" Foreground="White" BorderThickness="0" Padding="12,8"
                                HorizontalAlignment="Stretch" FontSize="11" FontWeight="Bold" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
