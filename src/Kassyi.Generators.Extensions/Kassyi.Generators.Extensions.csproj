<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- IDE0190: Target-typed new expressions are an optional style preference. -->
    <!-- CA1031: Catching general Exceptions is required in generators to report diagnostics instead of crashing the compiler. -->
    <!-- CA1307: StringComparison.Ordinal is not strictly needed for source code string manipulations. -->
    <!-- RS2008: Analyzer release tracking overhead is unnecessary for this generator project. -->
    <NoWarn>$(NoWarn);IDE0190;CA1031;CA1307;RS2008</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <Description>A set of extensions to simplify the code of generators.</Description>
    <PackageTags>generator;source generator;extensions;settings;exceptions;generation-time;auto</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="build/$(AssemblyName).props" Pack="true" PackagePath="build" />
    <None Include="buildMultiTargeting/$(AssemblyName).props" Pack="true" PackagePath="buildMultiTargeting" />
    <None Include="buildTransitive/$(AssemblyName).props" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

</Project>
