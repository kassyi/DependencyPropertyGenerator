<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup><HResourcesGenerator_Namespace>Kassyi.Generators.DependencyProperty</HResourcesGenerator_Namespace><EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles><RootNamespace>Kassyi.Generators.DependencyProperty</RootNamespace>
        <TargetFrameworks>netstandard2.0</TargetFrameworks><!-- ;net6.0;net7.0;net8.0 -->
        <NoWarn>$(NoWarn);CA1014;CA1308;CA1031;CA1307</NoWarn>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <PropertyGroup Label="NuGet">
        <NoWarn>$(NoWarn);NU5128;CA1724</NoWarn>
        <DevelopmentDependency>true</DevelopmentDependency>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <Description>C# Source Generator library to generate DependencyProperty.</Description>
        <PackageTags>dependency;property;dependency property;generator;source generator</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="H.Resources.Generator">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="IsExternalInit">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <ProjectReference Include="..\Kassyi.Generators.Extensions\Kassyi.Generators.Extensions.csproj" PrivateAssets="all" OutputItemType="Analyzer" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Kassyi.Generators.DependencyProperty.SnapshotTests" PublicKey="" />
        <InternalsVisibleTo Include="Kassyi.Generators.DependencyProperty.Tests" PublicKey="" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'net6.0' ">
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" VersionOverride="4.11.0" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'net7.0' ">
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" VersionOverride="4.11.0" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" VersionOverride="4.11.0" />
    </ItemGroup>
    
    <ItemGroup Label="Attributes">
        <EmbeddedResource Include="../Kassyi.Generators.DependencyProperty.Attributes/*.cs" Visible="false" />
        <AdditionalFiles Include="../Kassyi.Generators.DependencyProperty.Attributes/*.cs" Visible="false" HResourcesGenerator_Resource="true" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference
            Include="..\Kassyi.Generators.DependencyProperty.Attributes\Kassyi.Generators.DependencyProperty.Attributes.csproj"
            PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == '' ">
        <None Include="Kassyi.Generators.DependencyProperty.props" Pack="true" PackagePath="build" />
        <None Include="$(OutputPath)\netstandard2.0\Kassyi.Generators.DependencyProperty.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.3.1/cs" Visible="false" />
        <None Include="$(OutputPath)\netstandard2.0\Kassyi.Generators.DependencyProperty.Attributes.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.3.1/cs" Visible="false" />
        <None Include="$(OutputPath)\netstandard2.0\Kassyi.Generators.Extensions.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.3.1/cs" Visible="false" />
<!--        <None Include="$(OutputPath)\net6.0\Kassyi.Generators.DependencyProperty.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.6.0/cs" Visible="false" />-->
<!--        <None Include="$(OutputPath)\net6.0\Kassyi.Generators.DependencyProperty.Attributes.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.6.0/cs" Visible="false" />-->
<!--        <None Include="$(OutputPath)\net6.0\Kassyi.Generators.Extensions.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.6.0/cs" Visible="false" />-->
<!--        <None Include="$(OutputPath)\net7.0\Kassyi.Generators.DependencyProperty.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.7.0/cs" Visible="false" />-->
<!--        <None Include="$(OutputPath)\net7.0\Kassyi.Generators.DependencyProperty.Attributes.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.7.0/cs" Visible="false" />-->
<!--        <None Include="$(OutputPath)\net7.0\Kassyi.Generators.Extensions.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.7.0/cs" Visible="false" />-->
<!--        <None Include="$(OutputPath)\net8.0\Kassyi.Generators.DependencyProperty.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.8.0/cs" Visible="false" />-->
<!--        <None Include="$(OutputPath)\net8.0\Kassyi.Generators.DependencyProperty.Attributes.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.8.0/cs" Visible="false" />-->
<!--        <None Include="$(OutputPath)\net8.0\Kassyi.Generators.Extensions.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.8.0/cs" Visible="false" />-->
    </ItemGroup>

</Project>
